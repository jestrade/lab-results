rules_version = '2';

// LabResults — Cloud Storage security rules (KAN-4, spec §79).
//
// Layout mirrors ownership so the rule can be decided from the path alone:
//
//   users/{userId}/reports/{reportId}/{fileName}.pdf
//
// Original PDFs are never made public and never given a download token by the
// client. The app reads them back through a short-lived signed URL issued by
// the server, so a leaked path is not a leaked report.
//
// ── Capacity enforcement (spec §79) ───────────────────────────────────────
//
// This is the only place per-user and global storage caps are actually
// enforced. The browser runs the same arithmetic first so the user gets a
// useful message, but that check is a courtesy — this one is the control.
//
// The counters live in Firestore and are read here with firestore.get(). Two
// consequences worth knowing:
//
//   * Each upload costs a Firestore read or two. That is deliberate: a read is
//     far cheaper than the storage overage it prevents.
//   * The counters are updated by a Storage-triggered function *after* an
//     object finalizes, so parallel uploads can each pass this check before
//     any counter moves. The caps sit below the no-cost allowance precisely so
//     that race costs nothing, the client uploads one file at a time, and
//     reconcileUsage corrects drift nightly. See config/quotas.json.
//
// The numeric literals below are checked against config/quotas.json by
// src/domain/quotas.rules.test.ts — change the JSON, and the test tells you
// exactly which of these to change.

service firebase.storage {
  match /b/{bucket}/o {

    // ── identity ─────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // ── capacity ─────────────────────────────────────────────────────────

    function usagePath(userId) {
      return /databases/(default)/documents/usage/$(userId);
    }

    function systemPath() {
      return /databases/(default)/documents/systemUsage/global;
    }

    // UTC year-month, matching `currentUploadPeriod()` in src/domain/quotas.ts.
    // Rules have no date formatting, so it is assembled by hand.
    function currentPeriod() {
      return string(request.time.year()) + '-' +
        (request.time.month() < 10
          ? '0' + string(request.time.month())
          : string(request.time.month()));
    }

    // A user with no usage document has never uploaded — treat as zero rather
    // than denying, or the very first upload of every account would fail.
    function userBytes(userId) {
      return firestore.exists(usagePath(userId))
        ? firestore.get(usagePath(userId)).data.get('storageBytes', 0)
        : 0;
    }

    // A counter from a previous month reads as zero, which is how the monthly
    // allowance resets. Doing it lazily beats a scheduled reset job: a cron
    // that fails silently would hand every user an unlimited month.
    function userUploadsThisMonth(userId) {
      return (firestore.exists(usagePath(userId))
        && firestore.get(usagePath(userId)).data.get('uploadPeriod', '') == currentPeriod())
        ? firestore.get(usagePath(userId)).data.get('uploadsThisMonth', 0)
        : 0;
    }

    function systemBytes() {
      return firestore.exists(systemPath())
        ? firestore.get(systemPath()).data.get('storageBytes', 0)
        : 0;
    }

    // Kill switch. Lets an admin — or the reconciliation job, on finding that
    // true usage has passed the cap — stop all new uploads without a deploy.
    // An absent document means "not disabled", so a missing doc cannot lock
    // everybody out.
    function uploadsDisabled() {
      return firestore.exists(systemPath())
        && firestore.get(systemPath()).data.get('uploadsDisabled', false) == true;
    }

    match /users/{userId}/reports/{reportId}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
        && isVerified()
        && !uploadsDisabled()
        // Per-file: 25 MiB. Mirrors validateFile() in services/reports.ts.
        && request.resource.size <= 26214400
        && request.resource.contentType == 'application/pdf'
        && fileName.matches('.*\\.pdf')
        // Per-user: 400 MiB stored.
        && userBytes(userId) + request.resource.size <= 419430400
        // Per-user: 400 uploads per calendar month. The *.firebasestorage.app
        // bucket allows only 5K upload operations per month across the whole
        // project, which binds sooner than stored bytes ever will.
        && userUploadsThisMonth(userId) < 400
        // Global: 4 GiB stored across every user.
        && systemBytes() + request.resource.size <= 4294967296;

      // A stored report is immutable — a corrected report is a new upload,
      // linked to the old one by the versioning workflow (KAN-31). This also
      // closes a capacity hole: overwriting in place would change an object's
      // size without producing the finalize event the counters rely on.
      allow update: if false;

      allow delete: if isOwner(userId) || isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
