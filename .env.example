# Firebase web app config. Copy to `.env.local` and fill from the Firebase
# console (Project settings -> Your apps -> Web app). These values are public
# by design — they identify the project, they do not grant access. Access is
# enforced by firestore.rules / storage.rules, never by hiding these.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Point the SDK at the local emulator suite instead of the live project.
VITE_USE_FIREBASE_EMULATORS=true

# Sentry (KAN-35). Leave blank to disable error reporting entirely.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_APP_VERSION=dev
