# ─────────────────────────────────────────────────────────────────────────────
# THE single source of environment configuration for this project.
#
# `functions/.env` and `functions/.env.local` are GENERATED from this file by
# `npm run sync:env`. Do not edit those; edit this one.
#
# The prefix is the security boundary:
#
#   VITE_*   PUBLIC. Vite inlines these into the browser bundle. Anyone can
#            read them. Fine for Firebase web config, which identifies the
#            project rather than granting access to it.
#
#   others   SERVER-ONLY. Never reach the browser; routed to Cloud Functions.
#            Credentials go here, without a VITE_ prefix. `sync:env` refuses to
#            run if a known secret is given one.
#
# This file is gitignored. `.env.example` is the committed template.
# ─────────────────────────────────────────────────────────────────────────────

# ── Web app: Firebase (public by design) ────────────────────────────────────
VITE_FIREBASE_API_KEY=
# The DEFAULT <project>.firebaseapp.com value. Do not change it to your
# Hosting domain without also adding that domain's /__/auth/handler to the
# OAuth client's authorised redirect URIs — see the note in .env.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Point the app at the local emulator suite instead of the live project.
# Deploy the rules first when running against the real project:
#   firebase deploy --only firestore:rules,firestore:indexes,storage
VITE_USE_FIREBASE_EMULATORS=true

# Region the callable functions are deployed to — the account-deletion callable
# is invoked from the browser, and `getFunctions` otherwise assumes
# us-central1. Must match FUNCTIONS_REGION (functions/src/region.ts); both
# default to us-east1, so set this only if the Storage bucket ever moves. A
# mismatch surfaces in the browser as a CORS error, which names nothing useful.
VITE_FUNCTIONS_REGION=us-east1

# ── Web app: observability ──────────────────────────────────────────────────
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_APP_VERSION=dev

# GA4 measurement id (G-XXXXXXXXXX). Blank disables analytics entirely — no
# script is fetched and no request is made, which is what local development
# and the test suite run with.
#
# What is sent is deliberately narrow: route patterns (`/variables/:variableId`,
# never `/variables/hemoglobin`), no user id, no advertising signals. See the
# header of src/lib/analytics.ts for why that is not optional in an app whose
# URLs name laboratory tests.
VITE_GA_MEASUREMENT_ID=

# ── Server: AI provider selection (non-secret, deployed as function config) ──
# Switching provider: see functions/src/ai/registry.ts and docs/ai.md.
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash

# Set true only after enabling billing on the Gemini API project. On the free
# tier Google's terms allow submitted content to be used to improve their
# products; leaving this false makes the app report that truthfully.
GEMINI_BILLING_ENABLED=false

AI_MAX_OUTPUT_TOKENS=2048
AI_TEMPERATURE=0
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2

# ── Server: secrets ─────────────────────────────────────────────────────────
# Local/emulator only. Deployed functions read this from Secret Manager:
#   firebase functions:secrets:set GEMINI_API_KEY
GEMINI_API_KEY=
